<?xml version="1.0" encoding="UTF-8"?>
<project default="cleanup_after" basedir=".">
	<!-- Dependencies START -->
	<property name="json.version" value="26.2.6" />
	<property name="proxyautoconfig.version" value="26.1.2" />
	
	<!-- The classes of all dependencies in "lib" are embedded into the resulting AntBuildHelp.jar, so its
	     Maven POM must not list them as dependencies.
	     "apacheant" is needed at build time only and is not included in the resulting AntBuildHelp.jar -->
	<property name="apacheant.version" value="1.10.17" />

	<!-- Test dependency, needed at build time only -->
	<property name="junit.version" value="1.13.4" />
	<!-- Dependencies END -->
	
	<available file="${user.home}/git/codeSigning.properties" property="codeSigningPropertiesAvailable" />

	<target name="build_setup">
		<echo>Java/JVM HOME: ${java.home}</echo>
		<echo>Java/JVM version: ${ant.java.version}</echo>
		<echo>Java/JVM detailed version: ${java.version}</echo>

		<loadfile property="build.version" srcFile="build.version" failonerror="false" />
		<property name="build.version" value="26.0.0" />
		<echo message="build.version: ${build.version}" />

		<property file="${user.home}/git/codeSigning.properties" />

		<property environment="env"/>

		<property name="lib.dir" value="lib" />
		<property name="lib.ant.dir" value="lib_ant" />
		<!-- Maven standard directory layout -->
		<property name="src.dir" value="src/main/java" />
		<property name="resources.dir" value="src/main/resources" />
		<property name="test.src.dir" value="src/test/java" />
		<property name="lib.test.dir" value="lib_test" />
		<property name="build.dir" value="build" />
		<property name="classes.dir" value="${build.dir}/classes" />
		<property name="javadoc.dir" value="${build.dir}/javadoc" />
		<property name="test.classes.dir" value="${build.dir}/test-classes" />
		<property name="jar.file" value="${build.dir}/antbuildhelp-${build.version}.jar" />
		<property name="javadoc.jar.file" value="${build.dir}/antbuildhelp-${build.version}-javadoc.jar" />
		<property name="sources.jar.file" value="${build.dir}/antbuildhelp-${build.version}-sources.jar" />

		<tstamp>
			<format property="buildTime" pattern="yyyy-MM-dd HH:mm:ss" locale="en" />
		</tstamp>
		<echo message="buildTime: ${buildTime}" />

		<condition property="HOME" value="${user.home}">
			<and>
				<isset property="user.home" />
				<available file="${user.home}" type="dir" />
			</and>
		</condition>
		<condition property="HOME" value="${env.HOME}">
			<and>
				<isset property="env.HOME" />
				<available file="${env.HOME}" type="dir" />
			</and>
		</condition>
		<fail message="Property &quot;env.HOME&quot; or &quot;user.home&quot; was not set properly" unless="HOME" />
	</target>
	
	<target name="cleanup_before" depends="build_setup">
		<delete dir="${build.dir}" />
	</target>

	<target name="download_dependencies" depends="get_ant, get_json, get_proxyautoconfig" />

	<target name="compile" depends="cleanup_before, build_setup, download_dependencies">
		<path id="compile.classpath">
			<fileset dir="${lib.dir}" includes="*.jar" />
			<fileset dir="${lib.ant.dir}" includes="*.jar" />
		</path>

		<mkdir dir="${classes.dir}" />
		<javac srcdir="${src.dir}" destdir="${classes.dir}" includeantruntime="false" release="17" classpathref="compile.classpath" />
	</target>

	<target name="jar" depends="compile">
		<mkdir dir="${build.dir}" />
		<jar destfile="${jar.file}" basedir="${classes.dir}" duplicate="fail">
			<manifest>
				<attribute name="Main-Class" value="de.soderer.antbuildhelp.AntBuildHelpMain" />
			</manifest>
			<fileset dir="${src.dir}" excludes="**/*.java" />
			<fileset dir="${resources.dir}" erroronmissingdir="false" />
			<!-- AntBuildHelp's own license file, if existing -->
			<fileset dir="." includes="LICENSE*" />
			<!-- Embed the classes of the runtime dependencies (not the jars themselves), so they are visible
			     for "java -jar", for Ant's typedef classloader and for Maven consumers alike.
			     META-INF is excluded, because the signature files of the signed dependency jars would
			     otherwise invalidate the resulting jar. Their license files are excluded, because every
			     embedded jar brings its own "LICENSE.txt" (duplicate entries break jarsigner).
			     duplicate="fail" makes any other duplicate entry (e.g. a class contained in both
			     dependencies) fail the build instead of producing a broken or ambiguous jar. -->
			<restrict>
				<archives>
					<zips>
						<fileset dir="${lib.dir}" includes="json-${json.version}.jar,proxyautoconfig-${proxyautoconfig.version}.jar" />
					</zips>
				</archives>
				<not>
					<or>
						<name name="META-INF/**" />
						<name name="LICENSE*" />
					</or>
				</not>
			</restrict>
		</jar>
	</target>

	<target name="sign_jar" depends="jar" if="codeSigningPropertiesAvailable">
		<signjar destDir="${build.dir}" alias="${CodeSigningKeyAlias}" keystore="${CodeSigningKeyStore}" storepass="${CodeSigningKeyStorePassword}" keypass="${CodeSigningKeyPassword}" preservelastmodified="true" tsaurl="${TsaUrl}">
			<path>
				<fileset dir="${build.dir}" includes="antbuildhelp-${build.version}.jar" />
			</path>
		</signjar>
	</target>

	<!-- Javadoc jar, required for Maven Central. Covers AntBuildHelp's own classes only - the embedded
	     json/proxyautoconfig classes are documented in their own artifacts. -->
	<target name="javadoc_jar" depends="compile">
		<mkdir dir="${javadoc.dir}" />
		<javadoc destdir="${javadoc.dir}" classpathref="compile.classpath" source="17" encoding="UTF-8" charset="UTF-8" docencoding="UTF-8" failonerror="true" additionalparam="-Xdoclint:none">
			<fileset dir="${src.dir}" includes="**/*.java" />
		</javadoc>
		<jar destfile="${javadoc.jar.file}" basedir="${javadoc.dir}" />
	</target>

	<!-- Sources jar, required for Maven Central (AntBuildHelp's own sources and resources only) -->
	<target name="sources_jar" depends="build_setup">
		<mkdir dir="${build.dir}" />
		<jar destfile="${sources.jar.file}">
			<fileset dir="${src.dir}" />
			<fileset dir="${resources.dir}" erroronmissingdir="false" />
		</jar>
	</target>

	<target name="compile_test" depends="compile, get_junit">
		<path id="test.classpath">
			<pathelement location="${test.classes.dir}" />
			<pathelement location="${classes.dir}" />
			<fileset dir="${lib.dir}" includes="*.jar" />
			<fileset dir="${lib.ant.dir}" includes="*.jar" />
			<fileset dir="${lib.test.dir}" includes="*.jar" />
		</path>

		<mkdir dir="${test.classes.dir}" />
		<javac srcdir="${test.src.dir}" destdir="${test.classes.dir}" includeantruntime="false" release="17" classpathref="test.classpath" />
	</target>

	<!-- Runs all JUnit 5 tests via the JUnit console launcher (no extra Ant libraries needed). The tests
	     use a local HTTP server only, no internet access. -->
	<target name="test" depends="compile_test">
		<java jar="${lib.test.dir}/junit-platform-console-standalone-${junit.version}.jar" fork="true" failonerror="true">
			<arg value="execute" />
			<arg value="--class-path" />
			<arg pathref="test.classpath" />
			<arg value="--scan-class-path" />
			<arg value="--fail-if-no-tests" />
		</java>
	</target>

	<target name="cleanup_after" depends="test, sign_jar, javadoc_jar, sources_jar">
		<delete dir="${classes.dir}" />
		<delete dir="${test.classes.dir}" />
		<delete dir="${javadoc.dir}" />
	</target>

	<!-- "ant-launcher" is needed by the tests only: Project.init() references org.apache.tools.ant.launch.AntMain,
	     which is not contained in ant.jar. Both are downloaded together, because the cleanup pattern "ant-*.jar"
	     would otherwise also delete the other one. -->
	<condition property="ant.available">
		<and>
			<available file="lib_ant/ant-${apacheant.version}.jar" />
			<available file="lib_ant/ant-launcher-${apacheant.version}.jar" />
		</and>
	</condition>
	<target name="get_ant" unless="ant.available">
		<mkdir dir="lib_ant/" />
		<delete>
			<fileset dir="lib_ant" includes="ant-*.jar" />
		</delete>
		<get src="https://repo1.maven.org/maven2/org/apache/ant/ant/${apacheant.version}/ant-${apacheant.version}.jar" dest="lib_ant/" />
		<get src="https://repo1.maven.org/maven2/org/apache/ant/ant-launcher/${apacheant.version}/ant-launcher-${apacheant.version}.jar" dest="lib_ant/" />
	</target>

	<available file="lib_test/junit-platform-console-standalone-${junit.version}.jar" property="junit.available" />
	<target name="get_junit" unless="junit.available">
		<mkdir dir="lib_test/" />
		<delete>
			<fileset dir="lib_test" includes="junit-platform-console-standalone-*.jar" />
		</delete>
		<get src="https://repo1.maven.org/maven2/org/junit/platform/junit-platform-console-standalone/${junit.version}/junit-platform-console-standalone-${junit.version}.jar" dest="lib_test/" />
	</target>

	<available file="lib/json-${json.version}.jar" property="json.available" />
	<target name="get_json" unless="json.available">
		<mkdir dir="lib/" />
		<delete>
			<fileset dir="lib" includes="json-*.jar" />
		</delete>
		<get src="https://github.com/hudeany/json/releases/download/${json.version}/json-${json.version}.jar" dest="lib/" />
	</target>

	<available file="lib/proxyautoconfig-${proxyautoconfig.version}.jar" property="proxyautoconfig.available" />
	<target name="get_proxyautoconfig" unless="proxyautoconfig.available">
		<mkdir dir="lib/" />
		<delete>
			<fileset dir="lib" includes="proxyautoconfig-*.jar" />
		</delete>
		<get src="https://github.com/hudeany/ProxyAutoConfig/releases/download/${proxyautoconfig.version}/proxyautoconfig-${proxyautoconfig.version}.jar" dest="lib/" />
	</target>
</project>
